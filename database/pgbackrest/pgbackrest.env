# pgBackRest settings for the local backup stack, read by both database
# containers. Production supplies the same names from its secret manager; see
# .env.example and docs/backup-and-recovery.md.
#
# This file configures the LOCAL stack only and deliberately contains no real
# credentials: MinIO's defaults are public knowledge and grant access to
# nothing outside this compose project.

PGBACKREST_STANZA=soroban-registry
PGBACKREST_PG1_PATH=/var/lib/postgresql/data
# pgBackRest connects to PostgreSQL as an OS user; without this it uses whoever
# ran the command, which inside `docker exec` is root, and there is no root role.
PGBACKREST_PG1_USER=postgres
PGBACKREST_PG1_DATABASE=postgres
PGBACKREST_LOG_PATH=/var/log/pgbackrest
PGBACKREST_LOCK_PATH=/tmp/pgbackrest
PGBACKREST_SPOOL_PATH=/var/spool/pgbackrest
PGBACKREST_ARCHIVE_ASYNC=y
PGBACKREST_COMPRESS_TYPE=zst
PGBACKREST_LOG_LEVEL_CONSOLE=info
PGBACKREST_LOG_LEVEL_FILE=detail

# repo1: local disk inside the container's repository volume.
PGBACKREST_REPO1_PATH=/var/lib/pgbackrest
PGBACKREST_REPO1_RETENTION_FULL=2

# repo2: MinIO, standing in for Cloudflare R2.
PGBACKREST_REPO2_TYPE=s3
PGBACKREST_REPO2_PATH=/soroban-registry
PGBACKREST_REPO2_S3_BUCKET=soroban-registry-backups
PGBACKREST_REPO2_S3_ENDPOINT=minio
PGBACKREST_REPO2_STORAGE_PORT=9000
PGBACKREST_REPO2_S3_REGION=auto
PGBACKREST_REPO2_S3_URI_STYLE=path
PGBACKREST_REPO2_S3_KEY=minioadmin
PGBACKREST_REPO2_S3_KEY_SECRET=minioadmin
# The local endpoint uses a self-signed certificate; production verifies R2's.
PGBACKREST_REPO2_STORAGE_VERIFY_TLS=n
PGBACKREST_REPO2_RETENTION_FULL=4
# Bundle small files: an unbundled backup is one object per database file,
# which is one round trip and one billed write each.
PGBACKREST_REPO2_BUNDLE=y
PGBACKREST_REPO2_CIPHER_TYPE=aes-256-cbc
PGBACKREST_REPO2_CIPHER_PASS=local-stack-passphrase-not-a-secret
